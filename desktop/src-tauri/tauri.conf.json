{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spires of Azeroth",
  "version": "1.0.3",
  "identifier": "com.thewowdb.spiresofazeroth",
  "build": {
    "beforeBuildCommand": "node stage.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Classic WoW roguelike deckbuilder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

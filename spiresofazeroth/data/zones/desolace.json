  "id": "centaur-clans",
  "name": "Centaur Clans",
  "icon": "inv_misc_head_centaur_01",
  "text": "Helping one clan angers another. Each Gelkis centaur you kill marks Magram as angered, and each Magram you kill marks Gelkis as angered. Angered clans open every fight with +1 Strength.",
  "hooks": {
   "on_kill": [
    {
     "op": "conditional",
     "if": {
      "type": "target_is_family",
      "family": "gelkis"
     },
     "then": [
      {
       "op": "set_flag",
       "flag": "magram-angered"
      }
     ]
    },
    {
     "op": "conditional",
     "if": {
      "type": "target_is_family",
      "family": "magram"
     },
     "then": [
      {
       "op": "set_flag",
       "flag": "gelkis-angered"
      }
     ]
    }
   ],
   "on_combat_start": [
    {
     "op": "conditional",
     "if": {
      "type": "flag_set",
      "flag": "magram-angered"
     },
     "then": [
      {
       "op": "apply",
       "status": "strength",
       "stacks": 1,
       "target": "all_enemies",
       "onlyType": "magram"
      }
     ]
    },
    {
     "op": "conditional",
     "if": {
      "type": "flag_set",
      "flag": "gelkis-angered"
     },
     "then": [
      {
       "op": "apply",
       "status": "strength",
       "stacks": 1,
       "target": "all_enemies",
       "onlyType": "gelkis"
      }
     ]
    }
   ]
  }
 },
